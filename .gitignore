# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# dev logs
dev-server.log
start-dev.vbs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit these!)
.env
.env.local
.env.*.local
.env.production
.env.development

# Never commit these files containing secrets
*.key
*.pem
*.crt
*.p12
*.pfx
credentials.json
secrets.json
*.secret
service-account.json
docker-compose.override.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

.playwright-test/
.playwright
.playwright-cli
.playwright-mcp
playwright-report/

# logs and temp artifacts
*.log
npm-install.log
temp-scripts/

# generated CJS scripts (temp helpers)
gen-mjs.cjs
create-pkgjson.cjs
check-deps.cjs

# test results
playwright-results.json

# dev server run files
.dev-server.pid

# dev monitor scripts
monitor.ps1

# handoff files (committed — remove if you want to keep session logs private)
# .agents/handoffs/*.md
!.agents/handoffs/HANDOFF_SCHEMA.md